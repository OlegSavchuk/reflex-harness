# Copy to .env and fill in. .env is gitignored.

# Atlas Hackathon Sandbox cluster (Connect -> Drivers -> Python)
MONGODB_URI=
MONGODB_DB=reflex

# Same value as MONGODB_URI. Used by the MongoDB MCP server in .mcp.json.
# scripts/mcp-mongodb.sh loads it from .env for the MCP server.
MDB_MCP_CONNECTION_STRING=

# OpenRouter: coding model + Jev (typesafe/jev-1.13) via the Decisions API
OPENROUTER_API_KEY=
CODING_MODEL=
JEV_MODEL=typesafe/jev-1.13

# Only needed for the manual-embedding fallback if Automated Embedding fails
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
